# ==============================================================================
# .gitignore — Production Delivery Only for Indian-Flowers.com
# Only files essential to running the production Next.js storefront and CMS
# are tracked. All AI agents, skills, tests, documentation, and secrets are excluded.
# ==============================================================================

# 1. AI Agents, Skills, and Automation Configurations
.agents/
.claude/
.gemini/
skills/
.skills/
skills-lock.json
AGENTS.md
prompt*.md
UI*.md
DEPLOYMENT*.md
COMPLETE_INSTALLATION.md
posthog-self-driving-report.md
graphify-out/
.graphify*

# 2. Documentation, Specifications & Internal Notes
*.md
docs/
*.docx
*.pdf
*.csv
*.xlsx

# 3. Test Scripts, Debugging Tools & Verification Artifacts
scripts/*
!scripts/prebuild.js
!scripts/import-woocommerce.mjs
!scripts/migrate-base64-images.mjs
tests/
*.py
*.ps1
*.sh
*.bat
inspect_screenshot*.png
*screenshot*.png
desktop_*.png
mobile_*.png
banners_*.png

# 4. Environment Variables, API Keys & Secrets
.env
.env.local
.env.*.local
*.env
*.env.*
env.txt
secrets/

# 5. Dependencies & Package Managers
node_modules/
/node_modules
/.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 6. Build Outputs, Cache & Compilation
.next/
/.next/
out/
/out/
build/
/build/
dist/
*.tsbuildinfo
next-env.d.ts
.vercel

# 7. Archives & Compressed Files
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# 8. Standalone Licensing Server Repository (Strict Separation)
licensing-server/
/licensing-server

# 9. Operating System & IDE Artifacts
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
